{
  "name": "interview-prep-api",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/scripts/seed.js",
    "briefs:leetcode": "node src/scripts/fetch-leetcode-descriptions.js",
    "briefs:build": "node src/scripts/build-static-briefs.js",
    "study-guides:generate": "node src/scripts/generate-study-guides.js",
    "reminder:test": "node src/scripts/send-test-push.js",
    "vapid:generate": "node src/scripts/generate-vapid-keys.js",
    "build:netlify": "node src/scripts/generate-study-guides.js && node scripts/generate-netlify-redirects.js && rm -f public/study.html",
    "open": "open http://localhost:3000",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "interview",
    "api",
    "dsa",
    "leetcode"
  ],
  "author": "NishthaSingh7",
  "license": "ISC",
  "description": "REST API for interview prep — coding problems by pattern and difficulty",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.4",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.13.0",
    "node-cron": "^4.6.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
